# ─────────────────────────────────────────────────────────────
# Newsletter (Brevo) — intégration /api/subscribe
# Copier ce fichier en .env.local (NON commité) et renseigner les valeurs.
# Sans ces variables, /api/subscribe répond en mode "preview" (aucune
# inscription réelle, aucune donnée transmise) — le formulaire reste un mock.
# ─────────────────────────────────────────────────────────────

# Fournisseur (informatif). Valeur attendue : brevo
EMAIL_PROVIDER=brevo

# Mode d'inscription : "test" (par défaut) ou "live".
#  - test  -> cible NEWSLETTER_TEST_LIST_ID
#  - live  -> cible NEWSLETTER_LIST_ID (ouverture publique, sur GO)
NEWSLETTER_MODE=test

# Clé API Brevo (Settings > SMTP & API > API Keys). SECRET — ne jamais committer.
BREVO_API_KEY=

# ID numérique des listes Brevo (Contacts > Lists).
NEWSLETTER_TEST_LIST_ID=     # liste "Test — Les Lois Invisibles"
NEWSLETTER_LIST_ID=          # liste "Lecteurs — Les Lois Invisibles" (future, publique)

# Expéditeur de l'e-mail de bienvenue (transactionnel). Optionnel.
# Si vide : l'inscription se fait quand même, sans e-mail de bienvenue.
# L'adresse doit être un expéditeur VÉRIFIÉ dans Brevo.
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=Les Lois Invisibles
